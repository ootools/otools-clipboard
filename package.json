{
  "name": "otools-clipboard",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build": "pnpm build:web && pnpm build:native",
    "build:web": "pnpm --dir vendor/otools-plugin-sdk build && node scripts/build-web.mjs",
    "build:native": "node scripts/build-native.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "test": "pnpm --dir web test",
    "typecheck": "pnpm --dir web typecheck"
  }
}
